# Общие настройки приложения
APP_ENV=development

# Реализация AgentClient: mock | gemini
# Для реальных прогонов (этап 5 / приёмка): gemini
AGENT_IMPL=gemini

# Gemini (значения только в .env, не в репозитории)
# Дефолт в config: gemini-3.6-flash (если GEMINI_MODEL пуст)
GEMINI_API_KEY=
GEMINI_MODEL=

# Путь к SQLite-файлу с результатами анализов.
SQLITE_PATH=data/analyses.db

# CORS: origins через запятую, без пробелов или с пробелами (обрезаются).
# Локально — Vite; в production добавьте URL Vercel (https://....vercel.app).
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
