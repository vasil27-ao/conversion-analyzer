# Общие настройки приложения
APP_ENV=development

# Реализация AgentClient: mock | gemini | openrouter
# Для реальных прогонов: gemini
# Если AGENT_IMPL=gemini и задан OPENROUTER_API_KEY — при сбое Gemini
# автоматически пробуется OpenRouter (Qwen free), без длинных ретраев.
AGENT_IMPL=gemini

# Gemini (значения только в .env, не в репозитории)
# Дефолт в config: gemini-3.6-flash (если GEMINI_MODEL пуст)
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenRouter — бесплатный запасной LLM (ключ: https://openrouter.ai/keys)
# Модель по умолчанию: qwen/qwen3-32b:free (при 404 смените на актуальный :free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-32b:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=https://conversion-analyzer.vercel.app
# OPENROUTER_SITE_NAME=Conversion Analyzer

# Путь к SQLite-файлу с результатами анализов.
SQLITE_PATH=data/analyses.db

# CORS: origins через запятую, без пробелов или с пробелами (обрезаются).
# Локально — Vite; в production добавьте URL Vercel (https://....vercel.app).
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# Опционально: прокси для Chromium при сборе страниц (нужен, если хостинг
# в датацентре, а сайт вроде Ozon режет IP: «нет соединения» / VPN).
# Пример: http://user:pass@host:port
COLLECTOR_PROXY_SERVER=
